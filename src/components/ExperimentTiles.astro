---
import data from '../data/experiments.json';

interface Experiment {
  name: string;
  tagline?: string;
  description: string;
  icon?: string;
  status?: string;
  year?: string;
  tags?: string[];
  page?: string;
  repo?: string;
}

const experiments = data.experiments as Experiment[];
---

<div class="tiles">
  {
    experiments.map((experiment, index) => {
      const primary = experiment.page ?? experiment.repo;
      return (
        <article class="tile" style={`--delay: ${index * 90}ms`}>
          <span class="tile-sheen" aria-hidden="true"></span>

          <header class="tile-head">
            <span class="tile-icon" aria-hidden="true">{experiment.icon ?? '🧪'}</span>
            {experiment.status && <span class={`tile-status status-${experiment.status}`}>{experiment.status}</span>}
          </header>

          <h3 class="tile-title">{experiment.name}</h3>
          {experiment.tagline && <p class="tile-tagline">{experiment.tagline}</p>}
          <p class="tile-description">{experiment.description}</p>

          {experiment.tags && experiment.tags.length > 0 && (
            <ul class="tile-tags">
              {experiment.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )}

          <footer class="tile-links">
            {experiment.page && (
              <a
                href={experiment.page}
                class={`tile-link ${primary === experiment.page ? 'is-primary' : ''}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>Visit page</span>
                <svg viewBox="0 0 24 24" aria-hidden="true" class="link-arrow">
                  <path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            )}
            {experiment.repo && (
              <a
                href={experiment.repo}
                class={`tile-link ${primary === experiment.repo ? 'is-primary' : ''}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg viewBox="0 0 16 16" aria-hidden="true" class="link-github">
                  <path
                    fill="currentColor"
                    d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-2.91-.88-2.91-2.9 0-.65.23-1.18.61-1.6-.06-.15-.27-.77.06-1.6 0 0 .62-.2 2.02.76a6.8 6.8 0 0 1 1.84-.25c.62 0 1.25.08 1.84.25 1.4-.96 2.02-.76 2.02-.76.33.83.12 1.45.06 1.6.38.42.61.95.61 1.6 0 2.03-1.13 2.7-2.92 2.9.29.26.55.75.55 1.51 0 1.09-.01 1.98-.01 2.25 0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
                  />
                </svg>
                <span>Source</span>
              </a>
            )}
          </footer>

          {primary && (
            <a href={primary} class="tile-overlay" target="_blank" rel="noopener noreferrer">
              <span class="visually-hidden">Open {experiment.name}</span>
            </a>
          )}
        </article>
      );
    })
  }
</div>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.75rem;
  }

  .tile {
    --accent: var(--olive-green);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 2rem;
    background-color: white;
    border: 1px solid var(--border-light);
    border-radius: 12px;
    overflow: hidden;
    isolation: isolate;
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.4s ease,
      border-color 0.4s ease;
    animation: tile-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    animation-delay: var(--delay, 0ms);
  }

  /* Animated accent bar that grows across the top on hover */
  .tile::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent), var(--gold), var(--copper));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Diagonal light sweep */
  .tile-sheen {
    position: absolute;
    inset: -60% -20%;
    z-index: -1;
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgba(212, 175, 55, 0.16) 50%,
      transparent 60%
    );
    transform: translateX(-120%);
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .tile:hover,
  .tile:focus-within {
    transform: translateY(-6px);
    border-color: var(--accent);
    box-shadow: 0 18px 40px -18px rgba(107, 123, 59, 0.45);
  }

  .tile:hover::before,
  .tile:focus-within::before {
    transform: scaleX(1);
  }

  .tile:hover .tile-sheen,
  .tile:focus-within .tile-sheen {
    transform: translateX(120%);
  }

  .tile-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .tile-icon {
    font-size: 2.5rem;
    line-height: 1;
    display: inline-block;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tile:hover .tile-icon,
  .tile:focus-within .tile-icon {
    transform: scale(1.15) rotate(-8deg);
  }

  .tile-status {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    color: var(--accent);
    background-color: rgba(107, 123, 59, 0.1);
  }

  .status-live::before {
    content: '';
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.4rem;
    border-radius: 50%;
    background-color: var(--accent);
    animation: pulse 2s ease-in-out infinite;
  }

  .status-wip {
    color: var(--copper);
    background-color: rgba(184, 115, 51, 0.12);
  }

  .status-archived {
    color: var(--text-light);
    background-color: rgba(0, 0, 0, 0.05);
  }

  .tile-title {
    font-size: 1.6rem;
    margin: 0;
  }

  .tile-tagline {
    margin: 0;
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 1.1rem;
    font-style: italic;
    color: var(--accent);
  }

  .tile-description {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-light);
  }

  .tile-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
  }

  .tile-tags li {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    color: var(--text-light);
    background-color: var(--bg-white);
    transition:
      border-color 0.3s ease,
      color 0.3s ease;
  }

  .tile:hover .tile-tags li,
  .tile:focus-within .tile-tags li {
    border-color: rgba(107, 123, 59, 0.4);
    color: var(--text-dark);
  }

  .tile-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: auto;
    padding-top: 1.25rem;
  }

  .tile-link {
    /* lift above the stretched overlay link */
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-light);
  }

  .tile-link.is-primary {
    color: var(--accent);
  }

  .tile-link:hover {
    color: var(--copper);
  }

  .tile-link svg {
    width: 1.05em;
    height: 1.05em;
    flex-shrink: 0;
  }

  .link-arrow {
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tile:hover .link-arrow {
    transform: translateX(4px);
  }

  /* Whole-tile click target, kept below the explicit links */
  .tile-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  .tile-overlay:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -4px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes tile-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.8);
    }
  }

  @media (max-width: 480px) {
    .tiles {
      grid-template-columns: 1fr;
    }

    .tile {
      padding: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile,
    .tile-icon,
    .tile-sheen,
    .link-arrow,
    .status-live::before {
      animation: none;
      transition: border-color 0.3s ease, color 0.3s ease;
    }

    .tile:hover,
    .tile:focus-within {
      transform: none;
    }

    .tile:hover .tile-icon,
    .tile:focus-within .tile-icon {
      transform: none;
    }
  }
</style>
